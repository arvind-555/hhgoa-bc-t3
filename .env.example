# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Piece 2 - Lenso.ai developer subscription token (Authorization: Bearer <key>)
LENSO_API_KEY=

# Piece 3 - Polygon Amoy testnet (chain id 80002)
# RPC endpoint. Leave as-is for the public node, or point at a private one
# (Alchemy / Infura / ...) if the public node is flaky.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Wallet - generated + filled in by `python src/chain_setup.py`.
# WALLET_PRIVATE_KEY is a SECRET: never commit the real .env, never share it.
# WALLET_ADDRESS is public - safe to paste into a faucet / explorer.
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
